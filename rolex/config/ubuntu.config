CONFIG_LOCALVERSION="-msm89x7"
# CONFIG_LOCALVERSION_AUTO is not set
# Root filesystem and first-console drivers must be available before /usr/modules.
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
CONFIG_CHARGER_SMB347=y
CONFIG_BATTERY_CW2015=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_XIAOMI_ROLEX_NT35521S_EBBG=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_REGULATOR_TPS65132=y
CONFIG_LEDS_QCOM_LPG=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_QCOM_PBS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_U_ETHER=y
CONFIG_INPUT_EVDEV=y
CONFIG_DEBUG_FS=y
# CONFIG_SECURITY_LOCKDOWN_LSM is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# Transparent proxy support; load on demand, not during every boot.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NF_TPROXY_IPV4=m
CONFIG_NF_TPROXY_IPV6=m
CONFIG_NF_SOCKET_IPV4=m
CONFIG_NF_SOCKET_IPV6=m
CONFIG_NFT_TPROXY=m
CONFIG_NFT_SOCKET=m
CONFIG_NETFILTER_XT_TARGET_TPROXY=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_NFT_COMPAT=m
# Removable microSD: FAT32/exFAT plus Linux filesystems and UTF-8 filenames.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=m
CONFIG_EXT4_FS=y
CONFIG_NLS_UTF8=m
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_CODEPAGE_936=m

# Front and rear cameras use Qualcomm CCI and CAMSS with RAW10 capture.
CONFIG_I2C_QCOM_CCI=m
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_VIDEO_OV5675=m
CONFIG_VIDEO_OV13850=m
